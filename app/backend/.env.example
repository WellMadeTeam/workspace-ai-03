# The LLM service provider's key; each deployment has its own.
GROQ_API_KEY="your key"

# Optional: set true to send anonymous product events to a self-hosted
# OpenPanel project. Leave false for local development without collection.
ANALYTICS_ENABLED=false
OPENPANEL_API_URL=
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

# Optional: the proxy the calls to the LLM service provider go through, for a
# network the provider refuses; a special character in the user or the password
# is percent-encoded, such as %40 for @.
# HTTPS_PROXY=http://<proxy-user>:<proxy-password>@<proxy-host>:<proxy-port>

# Optional: comma-separated origins allowed to open a board socket, such as
# http://<university-vm-ipv4>:<port>; when unset, the Origin must match the
# address the browser opened.
# WS_ALLOWED_ORIGINS=

# Observability is disabled by default.
OBSERVABILITY_ENABLED=false

# Use development, staging, or production.
OBSERVABILITY_ENVIRONMENT=development

# Use the base OTLP/HTTP endpoint without /v1/logs or /v1/metrics.
OBSERVABILITY_OTLP_ENDPOINT=

# Store the real Authorization header only in backend/.env.
OBSERVABILITY_AUTHORIZATION=

# OpenObserve stream used for request logs.
OBSERVABILITY_LOG_STREAM=backend_requests

# Export intervals, in seconds.
OBSERVABILITY_LOG_EXPORT_INTERVAL_SECONDS=1
OBSERVABILITY_METRIC_EXPORT_INTERVAL_SECONDS=10