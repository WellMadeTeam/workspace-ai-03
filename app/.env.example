# The settings Docker Compose reads for one deployment; copy it to app/.env.
# A local run needs none of them; see docs/setup.md.

# Two deployments on one machine need two project names, or they share the
# containers and the database volume.
COMPOSE_PROJECT_NAME=workspace-ai-<environment>

# The host port nginx publishes: 80 when unset.
HTTP_PORT=<port>
